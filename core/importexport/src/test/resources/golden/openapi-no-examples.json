{
  "openapi": "3.0.0",
  "info": { "title": "Bare API", "version": "1.0.0" },
  "paths": {
    "/things": {
      "get": {
        "responses": {
          "200": {
            "description": "A list of things",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "integer" },
                      "name": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
