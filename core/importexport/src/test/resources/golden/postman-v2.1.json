{
  "info": {
    "_postman_id": "a1b2",
    "name": "Billing",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Invoices",
      "item": [
        {
          "name": "List invoices",
          "request": {
            "method": "GET",
            "header": [ { "key": "Accept", "value": "application/json" } ],
            "url": {
              "raw": "{{baseUrl}}/invoices?page=1",
              "host": [ "{{baseUrl}}" ],
              "path": [ "invoices" ],
              "query": [ { "key": "page", "value": "1" } ]
            }
          },
          "response": [
            {
              "name": "OK",
              "code": 200,
              "status": "OK",
              "header": [ { "key": "Content-Type", "value": "application/json" } ],
              "body": "{\"invoices\":[]}"
            },
            {
              "name": "Server error",
              "code": 500,
              "body": "{\"error\":\"boom\"}"
            }
          ]
        },
        {
          "name": "Get invoice",
          "request": {
            "method": "GET",
            "url": "https://api.example.com/invoices/:invoiceId"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Create payment",
      "request": {
        "method": "POST",
        "url": { "raw": "{{baseUrl}}/payments", "path": [ "payments" ] },
        "body": { "mode": "raw", "raw": "{\"amount\":100}" }
      },
      "response": [
        { "name": "Created", "code": 201, "body": "{\"id\":\"pay_1\"}" }
      ]
    }
  ]
}
