    <!-- The explainer sheet, screen 1s. -->
    <string name="chaos_explain_title">What chaos profiles do</string>
    <string name="chaos_explain_lead">A profile is a set of odds that break responses on purpose, so your app meets the failures a real network hands it. One profile is active at a time and applies to every route.</string>
    <string name="chaos_explain_error_title">An error status</string>
    <string name="chaos_explain_error_body">The mock is replaced with 500, 503 or 429.</string>
    <string name="chaos_explain_reset_title">A dead connection</string>
    <string name="chaos_explain_reset_body">Part of the body is written, then the socket closes with no clean end.</string>
    <string name="chaos_explain_malformed_title">A truncated body</string>
    <string name="chaos_explain_malformed_body">Content-Length still claims the full size, so a strict client reports an incomplete read.</string>
    <string name="chaos_explain_seed_title">The same failures twice</string>
    <string name="chaos_explain_seed_body">One seed replays one sequence, so a flaky result can be reproduced on demand.</string>
    <string name="chaos_explain_closing">At most one failure fires per request. A route\'s own delay is separate and survives a profile of None.</string>
    <string name="chaos_explain_dismiss">Got it</string>
