    <string name="chaos_error_probability">Inject an error status</string>
    <string name="chaos_error_help">Replaces the response with 500, 503 or 429.</string>
    <string name="chaos_reset_probability">Kill the connection</string>
    <string name="chaos_reset_help">Writes part of the body and then closes the socket without a clean end.</string>
    <string name="chaos_reset_bytes">Bytes written before the reset</string>
    <string name="chaos_malformed_probability">Send a truncated body</string>
    <string name="chaos_malformed_help">Content-Length still declares the full length, so a strict client reports an incomplete body.</string>
    <string name="chaos_malformed_percent">Percent of the body sent</string>
